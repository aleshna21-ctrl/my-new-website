# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force scripts and web code to LF for Linux / Docker / Codex compatibility
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows PowerShell and batch files keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
