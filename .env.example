# ==============================================================================
# AIOS Command Center & Hermes Gateway - Environment Variables
# Copy to .env on your Hostinger VPS: cp .env.example .env
# ==============================================================================

# Port on the host machine to access the AIOS Command Center
HUD_PORT=5050

# Interface binding on the host machine:
# Set to 0.0.0.0 to access directly via http://2.25.249.27:5050
# Set to 127.0.0.1 if using an Nginx or Caddy reverse proxy on your Hostinger VPS
HUD_BIND_IP=0.0.0.0

# Timezone for the daily board and smart scheduler
TZ=UTC

# Hermes Gateway & Inference Configuration:
# In Docker Compose, Hermes service is reached at http://hermes:8080
# For local host development, Hermes is reached at http://127.0.0.1:8080
HERMES_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
HERMES_GATEWAY_URL=http://127.0.0.1:8080/gateway/v1/rpc
HERMES_MODEL=qwen3:4b
HERMES_GATEWAY_SECRET=hermes-aios-sec-gate-v1-4f9e8a7c2b

# Hostinger Hermes Agent loopback / container port (mapped to 32768 on VPS)
HERMES_AGENT_URL=http://127.0.0.1:32768

# Upstream LLM engine (Ollama on host):
OLLAMA_UPSTREAM=http://127.0.0.1:11434

# Optional: Directory Path Overrides (Defaults to relative paths within repository)
# HUD_DIR=/app
# JEV_PROJECT_ROOT=/app
# SECOND_BRAIN_DIR=/app/vault
# JEV_OFFLINE_DIR=/app/inbox
# GTM_RESEARCH_DIR=/app/outbox/gtm
# NOTIFICATION_OUTBOX_DIR=/app/outbox
# MARK_LVI_DIR=/app/mark-lvi
