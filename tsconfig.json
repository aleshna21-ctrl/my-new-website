{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "~encore/*": ["./encore.gen/*"]
    }
  },
  "include": [
    "services/**/*"
  ]
}
