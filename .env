# ==============================================================================
# AIOS Command Center - Environment Variables
# Copy to .env on your Hostinger VPS: cp .env.example .env
# ==============================================================================

# Port on the host machine to access the AIOS Command Center
HUD_PORT=5050

# Interface binding on the host machine:
# Set to 0.0.0.0 to access directly via http://2.25.249.27:5050
# Set to 127.0.0.1 if using an Nginx or Caddy reverse proxy on your Hostinger VPS
HUD_BIND_IP=0.0.0.0

# Timezone for the daily board and smart scheduler
TZ=UTC

# Optional: Path to read-only Second Brain Obsidian vault (default is ./vault)
# SECOND_BRAIN_DIR=/app/vault

# Local Hermes Model Endpoint Override (bind directly to local Ollama qwen3:4b instance):
HERMES_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
HERMES_MODEL=qwen3:4b
